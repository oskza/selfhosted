services:
{% for service in media_services %}
{% set homepage_label_prefix = 'homepage' if service.homepage.public | default(false) else 'homepage.instance.admin' %}

  {{ service.name }}:
    image: ghcr.io/hotio/{{ service.name }}:{{ service.version }}
    container_name: {{ service.name }}
    restart: unless-stopped
    logging:
      driver: json-file
    networks:
      - media_net
      - proxy_net
{% if service.name == 'plex' %}
    ports:
      - {{ service.port }}:{{ service.port }}
{% endif %}
    volumes:
      - {{ service.name }}_data:/config
{% if service.name == 'plex' %}
      - plex_transcode:/transcode
{% for dir in directories | dict2items
           | selectattr('key', 'match', '^media(_.*)?$')
           | map(attribute='value') | list %}
      - {{ dir }}/media:{{ dir | regex_replace('.*/(data_[^/]+)$', '/\\1') }}/media
{% endfor %}
{% elif service.name == 'qbittorrent' %}
      - {{ directories.media_1 }}/downloads/torrents:/data_1/downloads/torrents
{% else %}
{% for dir in directories | dict2items
           | selectattr('key', 'match', '^media(_.*)?$')
           | map(attribute='value') | list %}
      - {{ dir }}:{{ dir | regex_replace('.*/(data_[^/]+)$', '/\\1') }}
{% endfor %}
{% endif %}
    environment:
      TZ: {{ timezone }}
      PUID: {{ main_user.uid }}
      PGID: {{ main_user.gid }}
      UMASK: {{ umask | default('002') }}
      WEBUI_PORTS: {{ service.port }}/tcp,{{ service.port }}/udp
{% if service.name == 'plex' %}
      PLEX_ADVERTISE_URL: {{ service.advertise_url }}
      PLEX_CLAIM_TOKEN: {{ service.claim_token }}
{% endif %}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.{{ service.name }}.rule=Host(`{{ service.host }}`)"
      - "traefik.http.routers.{{ service.name }}.entrypoints=https"
      - "traefik.http.routers.{{ service.name }}.tls=true"
      - "traefik.http.services.{{ service.name }}.loadbalancer.server.port={{ service.port }}"
      - "traefik.docker.network=proxy_net"
      - "{{ homepage_label_prefix }}.name={{ service.homepage.title }}"
      - "{{ homepage_label_prefix }}.description={{ service.homepage.description }}"
      - "{{ homepage_label_prefix }}.icon={{ service.homepage.icon }}"
      - "{{ homepage_label_prefix }}.href=https://{{ service.host }}"
      - "{{ homepage_label_prefix }}.group={{ service.homepage.group }}"
      - "{{ homepage_label_prefix }}.weight={{ service.homepage.order | default(0) }}"
      - "{{ homepage_label_prefix }}.widget.type={{ service.name }}"
      - "{{ homepage_label_prefix }}.widget.url=http://{{ service.name }}:{{ service.port }}"
{% if service.homepage.fields is defined and service.homepage.fields | length > 0 %}
      - "{{ homepage_label_prefix }}.widget.fields={{ service.homepage.fields | to_json | regex_replace('"', '\\"')}}"
{% endif %}
{% if service.homepage.username is defined and service.homepage.username and service.homepage.password is defined and service.homepage.password %}
      - "{{ homepage_label_prefix }}.widget.username={{ service.homepage.username }}"
      - "{{ homepage_label_prefix }}.widget.password={{ service.homepage.password }}"
{% elif service.homepage.key is defined and service.homepage.key %}
      - "{{ homepage_label_prefix }}.widget.key={{ service.homepage.key }}"
{% endif %}
{% endfor %}

networks:
  media_net:
    name: media_net
  proxy_net:
    external: true

volumes:
{% for service in media_services %}
  {{ service.name }}_data:
    name: "{{ service.name }}_data"
{% endfor %}
{% if 'plex' in (media_services | map(attribute='name')) %}
  plex_transcode:
    name: plex_transcode
{% endif %}
