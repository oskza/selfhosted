- Performance:
    - CPU:
        widget:
            type: glances
            version: 4
            url: http://glances:{{ glances_port }}
            metric: cpu
            chart: false
    - RAM:
        widget:
            type: glances
            version: 4
            url: http://glances:{{ glances_port }}
            metric: memory
            chart: false
    - ETH:
        widget:
            type: glances
            version: 4
            url: http://glances:{{ glances_port }}
            metric: network:eth0
            chart: false
    - SSD:
        widget:
            type: glances
            version: 4
            url: http://glances:{{ glances_port }}
            metric: disk:{{ drives.system.device }}
            chart: false
