services:
  code-server:
    build:
      context: .
    image: my-code-server
    container_name: code-server
    restart: unless-stopped
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - data:{{ code_server.home }}
      - {{ code_server.workspace.src }}:{{ code_server.workspace.dest }}
    environment:
      TZ: {{ timezone }}
      PUID: {{ main_user.uid }}
      PGID: {{ main_user.gid }}
      PASSWORD: {{ code_server.password }}
      SUDO_PASSWORD: {{ code_server.sudo_password }}
      PROXY_DOMAIN: {{ code_server.host }}
      PORT: {{ code_server.port }}
      HOME: {{ code_server.home }}
      DEFAULT_WORKSPACE: {{ code_server.workspace.dest }}
    labels:
      - "traefik.enable=true"
      - "traefik.http.routers.code-server.rule=Host(`{{ code_server.host }}`)"
      - "traefik.http.routers.code-server.entrypoints=https"
      - "traefik.http.routers.code-server.tls=true"
      - "traefik.http.services.code-server.loadbalancer.server.port={{ code_server.port }}"
      - "homepage.name=VS Code"
      - "homepage.description=Code Server"
      - "homepage.icon=/icons/vscode.png"
      - "homepage.href=https://{{ code_server.host }}"
      - "homepage.group=Utils"
      - "homepage.weight=2"
networks:
  default:
    name: proxy_net
    external: true
volumes:
  data:
    name: code-server_data
